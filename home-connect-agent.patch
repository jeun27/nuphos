+
+const agent = (over: Partial<RuntimeInstance> = {}): RuntimeInstance => ({
+  id,
+  provider: 'claude-code',
+  label: 'Claude Code',
+  status: 'active',
+  kind: 'managed',
+  createdAt: '2026-11-05T00:00:00Z',
